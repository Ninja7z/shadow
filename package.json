{
  "name": "shadow-gateway",
  "version": "0.1.9",
  "description": "Shadow self-hosted AI gateway installer and interactive terminal setup",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.12.0"
  },
  "bin": {
    "shadow-gateway": "bin/shadow.js",
    "shadow-repository": "bin/repository.js",
    "shadow-feedback": "bin/feedback.js",
    "shadow-help": "bin/help.js"
  },
  "files": [
    "bin/**",
    "src/**",
    "config/*.yaml",
    "config/mcp-hub.example.json",
    ".env.example",
    "requirements.txt",
    "requirements.lock",
    "scripts/deprecate-legacy-versions.mjs",
    "scripts/shadow.py",
    "scripts/smoke_test.py",
    "scripts/validate_config.py",
    "scripts/shadow-mcp-hub.sh",
    "scripts/shadow-mcp-admin.sh",
    "scripts/patch-mcp-hub-compat.mjs",
    "docs/client-integrations.md",
    "docs/terminal-installation.md",
    "docs/pt-BR/instalacao-terminal.md",
    "docs/claude-code.md",
    "docs/mcp-hub.md",
    "docs/smoke-tests.md",
    "docs/unified-gateway.md",
    "docs/pt-BR/integracao-clientes.md",
    "docs/pt-BR/integracao-claude-code.md",
    "docs/pt-BR/hub-mcp.md",
    "docs/pt-BR/testes-smoke.md",
    "docs/pt-BR/gateway-unificado.md",
    "docs/licensing.md",
    "docs/pt-BR/licenca.md",
    "docs/assets/shadow-hero.svg",
    "docs/assets/shadow-hero-pt.svg",
    "LICENSE",
    "README.md",
    "README.en.md",
    "docs/releasing.md",
    "docs/pt-BR/publicacao.md"
  ],
  "scripts": {
    "test": "node --test tests/npm-cli.test.js",
    "pack:check": "npm pack --dry-run",
    "deprecate:legacy": "node scripts/deprecate-legacy-versions.mjs"
  },
  "dependencies": {
    "@clack/prompts": "1.9.0",
    "yaml": "2.9.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ninja7z/shadow.git"
  },
  "homepage": "https://github.com/Ninja7z/shadow#readme",
  "bugs": {
    "url": "https://github.com/Ninja7z/shadow/issues"
  },
  "keywords": [
    "ai",
    "gateway",
    "litellm",
    "ollama",
    "openai-compatible",
    "anthropic",
    "self-hosted",
    "cli"
  ]
}
